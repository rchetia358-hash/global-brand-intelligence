# Global Brand Intelligence — Environment Variables
# Copy this file to .env and fill in values where needed.

# Server port (default: 3000)
PORT=3000

# Optional: NewsAPI.org key for supplemental headline search
# Get a free key at https://newsapi.org/register
# Without this key, the app uses RSS feeds only (fully functional).
NEWS_API_KEY=

# Cache TTL in seconds (default: 900 = 15 minutes)
CACHE_TTL=900
